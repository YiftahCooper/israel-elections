{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:israel-elections:poll-archive:k25:0.1-draft",
  "title": "Research-only polling archive pilot",
  "type": "object",
  "required": [
    "schemaVersion",
    "electionId",
    "window",
    "coverageStatus",
    "polls"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1-draft"
    },
    "electionId": {
      "const": "k25"
    },
    "window": {
      "type": "object"
    },
    "coverageStatus": {
      "const": "incomplete-pilot"
    },
    "polls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "electionId",
          "outlet",
          "fieldworkFirm",
          "firmEvidence",
          "publishedAt",
          "variant",
          "fieldworkDates",
          "sampleSize",
          "marginOfErrorPct",
          "population",
          "mode",
          "questionText",
          "undecidedSharePct",
          "undecidedDefinition",
          "sourceIds",
          "results",
          "validation",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "electionId": {
            "const": "k25"
          },
          "outlet": {
            "type": "string"
          },
          "fieldworkFirm": {
            "type": "string"
          },
          "firmEvidence": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date"
          },
          "variant": {
            "type": "string"
          },
          "fieldworkDates": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "sampleSize": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "marginOfErrorPct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "population": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "questionText": {
            "type": [
              "string",
              "null"
            ]
          },
          "undecidedSharePct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "undecidedDefinition": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reportedNameHe",
                "datasetListId",
                "mappingStatus",
                "seats",
                "voteSharePct",
                "belowThreshold"
              ],
              "properties": {
                "reportedNameHe": {
                  "type": "string",
                  "minLength": 1
                },
                "datasetListId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mappingStatus": {
                  "type": "string"
                },
                "seats": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 120
                },
                "voteSharePct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "belowThreshold": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "reportedSeatSubtotal",
              "seatCoverage",
              "status",
              "scenarioEligible"
            ],
            "properties": {
              "reportedSeatSubtotal": {
                "type": "integer"
              },
              "seatCoverage": {
                "enum": [
                  "complete",
                  "partial"
                ]
              },
              "status": {
                "enum": [
                  "reviewed-draft",
                  "partial",
                  "quarantined"
                ]
              },
              "scenarioEligible": {
                "const": false
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
